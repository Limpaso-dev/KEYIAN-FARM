generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// ORGANISATION, ACCESS AND AUDIT
// =====================================================================

enum Department {
  hr
  livestock
  mva
  sales
  stores
  crops
  accounts
}

/// super_admin/admin manage the system, general_manager oversees every
/// department, head/officer belong to exactly one department.
enum Role {
  super_admin
  admin
  general_manager
  head
  officer
}

model User {
  id                          String           @id @default(uuid())
  name                        String
  email                       String           @unique
  phone                       String?
  password                    String
  role                        Role
  department                  Department?
  employeeId                  String?          @unique
  isActive                    Boolean          @default(true)
  mustChangePassword          Boolean          @default(true)
  lastLoginAt                 DateTime?
  emailVerified               Boolean          @default(true)
  emailVerificationCodeHash   String?
  emailVerificationExpiresAt  DateTime?
  emailVerificationAttempts   Int              @default(0)
  emailVerificationLastSentAt DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  employee                    Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs                   AuditLog[]
  requisitions                Requisition[]    @relation("RequisitionRequestedBy")
  requisitionsDecided         Requisition[]    @relation("RequisitionDecidedBy")
  productRequests             ProductRequest[] @relation("ProductRequestedBy")
  productRequestsHandled      ProductRequest[] @relation("ProductRequestHandledBy")
  transactions                Transaction[]

  @@index([role, department, isActive])
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String?
  action    String
  actorId   String?
  actorRole String?
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

/// Running counters for human-readable document numbers (REQ-2026-0001 ...).
model Sequence {
  key   String @id
  value Int    @default(0)
}

// =====================================================================
// HR: STAFF, CONTRACTS, PAYROLL, DISCIPLINE, TERMINATION, MEMBERS
// =====================================================================

model Employee {
  id                  String             @id @default(uuid())
  staffNumber         String             @unique
  firstName           String
  lastName            String
  nationalId          String?            @unique
  gender              String?
  dateOfBirth         DateTime?
  phone               String?
  email               String?
  address             String?
  department          Department
  jobTitle            String
  jobGroup            String?
  employmentType      String             @default("permanent")
  dateHired           DateTime
  basicSalary         Decimal            @default(0) @db.Decimal(18, 2)
  bankName            String?
  bankAccount         String?
  kraPin              String?
  nextOfKinName       String?
  nextOfKinNationalId String?
  nextOfKinPhone      String?
  dependants          Int                @default(0)
  status              String             @default("active")
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User?
  contracts           Contract[]
  salaryReviews       SalaryReview[]
  payrolls            Payroll[]
  disciplinaryCases   DisciplinaryCase[]
  termination         Termination?
  applicant           JobApplicant?

  @@index([department, status])
}

model Contract {
  id             String    @id @default(uuid())
  contractNumber String    @unique
  employeeId     String
  contractType   String
  startDate      DateTime
  endDate        DateTime?
  salary         Decimal   @db.Decimal(18, 2)
  terms          String?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
}

model SalaryReview {
  id               String   @id @default(uuid())
  employeeId       String
  reviewType       String
  effectiveDate    DateTime
  previousSalary   Decimal  @db.Decimal(18, 2)
  newSalary        Decimal  @db.Decimal(18, 2)
  previousJobTitle String?
  newJobTitle      String?
  previousJobGroup String?
  newJobGroup      String?
  reason           String
  createdAt        DateTime @default(now())
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveDate])
}

model Payroll {
  id            String    @id @default(uuid())
  employeeId    String
  period        String
  basicSalary   Decimal   @db.Decimal(18, 2)
  allowances    Decimal   @default(0) @db.Decimal(18, 2)
  deductions    Decimal   @default(0) @db.Decimal(18, 2)
  netPay        Decimal   @db.Decimal(18, 2)
  status        String    @default("with_finance")
  paidAt        DateTime?
  transactionId String?   @unique
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, period])
  @@index([period, status])
}

model DisciplinaryCase {
  id           String    @id @default(uuid())
  caseNumber   String    @unique
  employeeId   String
  incidentDate DateTime
  offence      String
  actionTaken  String
  letterServed Boolean   @default(false)
  letterDate   DateTime?
  description  String?
  outcome      String?
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, incidentDate])
}

model Termination {
  id              String   @id @default(uuid())
  employeeId      String   @unique
  terminationType String
  terminationDate DateTime
  reason          String
  finalDues       Decimal  @default(0) @db.Decimal(18, 2)
  clearanceStatus String   @default("pending")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

/// Pioneer founder members and their hereditary successors. A successor
/// is another Member row that points at the member it succeeded.
model Member {
  id                    String          @id @default(uuid())
  memberNumber          String          @unique
  firstName             String
  lastName              String
  nationalId            String?         @unique
  phone                 String?
  address               String?
  joinDate              DateTime
  shares                Int             @default(0)
  isPioneer             Boolean         @default(true)
  status                String          @default("active")
  predecessorId         String?
  relationship          String?
  successionDate        DateTime?
  successionReason      String?
  successionReasonOther String?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  predecessor           Member?         @relation("MemberSuccession", fields: [predecessorId], references: [id], onDelete: Restrict)
  successors            Member[]        @relation("MemberSuccession")
  payments              MemberPayment[]

  @@index([status])
}

/// Staff establishment: a post is advertised, people apply, some are
/// shortlisted and interviewed, and those who pass can be hired.
model JobAdvert {
  id             String         @id @default(uuid())
  advertNumber   String         @unique
  jobTitle       String
  department     Department
  jobGroup       String?
  employmentType String         @default("permanent")
  posts          Int            @default(1)
  advertDate     DateTime
  closingDate    DateTime?
  requirements   String?
  status         String         @default("open")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  applicants     JobApplicant[]

  @@index([status, advertDate])
}

model JobApplicant {
  id              String    @id @default(uuid())
  advertId        String
  firstName       String
  lastName        String
  nationalId      String?
  phone           String
  email           String?
  qualifications  String?
  appliedOn       DateTime
  stage           String    @default("applied")
  interviewDate   DateTime?
  interviewPanel  String?
  interviewScore  Decimal?  @db.Decimal(5, 2)
  interviewNotes  String?
  rejectionReason String?
  employeeId      String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  advert          JobAdvert @relation(fields: [advertId], references: [id], onDelete: Restrict)
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([advertId, stage])
}

// =====================================================================
// LIVESTOCK
// =====================================================================

model Animal {
  id             String         @id @default(uuid())
  tagNumber      String         @unique
  name           String?
  breed          String?
  sex            String
  dateOfBirth    DateTime?
  source         String         @default("born_on_farm")
  damId          String?
  sireId         String?
  sireDetails    String?
  lactationCount Int            @default(0)
  status         String         @default("active")
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  dam            Animal?        @relation("Dam", fields: [damId], references: [id], onDelete: SetNull)
  sire           Animal?        @relation("Sire", fields: [sireId], references: [id], onDelete: SetNull)
  calvesAsDam    Animal[]       @relation("Dam")
  calvesAsSire   Animal[]       @relation("Sire")
  lactations     Lactation[]
  vaccinations   Vaccination[]
  healthRecords  HealthRecord[]
  milkRecords    MilkRecord[]

  @@index([status, sex])
}

model Lactation {
  id              String    @id @default(uuid())
  animalId        String
  lactationNumber Int
  calvingDate     DateTime
  calfId          String?
  dryOffDate      DateTime?
  status          String    @default("milking")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  animal          Animal    @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@unique([animalId, lactationNumber])
}

model Vaccination {
  id             String    @id @default(uuid())
  animalId       String
  vaccine        String
  date           DateTime
  dose           String?
  nextDueDate    DateTime?
  administeredBy String?
  notes          String?
  createdAt      DateTime  @default(now())
  animal         Animal    @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@index([date])
}

/// Disease cases, treatments and herd health checks. animalId is empty
/// for herd-wide events such as dipping or deworming the whole herd.
model HealthRecord {
  id         String   @id @default(uuid())
  animalId   String?
  recordType String
  date       DateTime
  condition  String
  treatment  String?
  vet        String?
  cost       Decimal  @default(0) @db.Decimal(18, 2)
  outcome    String   @default("under_treatment")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  animal     Animal?  @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@index([date, recordType])
}

model MilkRecord {
  id        String   @id @default(uuid())
  animalId  String
  date      DateTime @db.Date
  session   String
  litres    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@unique([animalId, date, session])
  @@index([date])
}

/// Milk sent from Livestock to MVA. MVA confirms what it received.
model MilkTransfer {
  id             String    @id @default(uuid())
  transferNumber String    @unique
  date           DateTime  @db.Date
  session        String
  dairy          String    @default("dairy_a")
  litres         Decimal   @db.Decimal(10, 2)
  status         String    @default("sent")
  receivedLitres Decimal?  @db.Decimal(10, 2)
  receivedAt     DateTime?
  receivedById   String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([date, status])
}

// =====================================================================
// MILK VALUE ADDITION (MVA)
// =====================================================================

/// Local farmers who deliver milk to MVA. supplierNumber is the short
/// number farmers are known by (130, 131, ...).
model MilkSupplier {
  id             String            @id @default(uuid())
  supplierNumber Int               @unique
  firstName      String
  lastName       String
  nationalId     String?           @unique
  phone          String?
  location       String?
  paymentMethod  String            @default("mpesa")
  bankName       String?
  accountNumber  String?
  status         String            @default("active")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     MilkDelivery[]
  paymentLines   MilkPaymentLine[]
}

model MilkPrice {
  id            String   @id @default(uuid())
  effectiveDate DateTime @unique @db.Date
  pricePerLitre Decimal  @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime @default(now())
}

model MilkDelivery {
  id            String          @id @default(uuid())
  supplierId    String
  date          DateTime        @db.Date
  session       String
  litres        Decimal         @db.Decimal(10, 2)
  pricePerLitre Decimal         @db.Decimal(10, 2)
  amount        Decimal         @db.Decimal(18, 2)
  paymentRunId  String?
  notes         String?
  createdAt     DateTime        @default(now())
  supplier      MilkSupplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  paymentRun    MilkPaymentRun? @relation(fields: [paymentRunId], references: [id], onDelete: SetNull)

  @@index([date, supplierId])
}

/// One processing run: raw milk in, finished products out.
/// Where one day's milk went: Mala, Yoghurt, NKCC, Own use, L.Sale, Staff,
/// Police, School, Spoilage (the list is in config/catalog.js).
model MilkAllocation {
  id        String               @id @default(uuid())
  date      DateTime             @unique @db.Date
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  lines     MilkAllocationLine[]
  transfer  ProductTransfer?
}

model MilkAllocationLine {
  id           String         @id @default(uuid())
  allocationId String
  destination  String
  quantity     Decimal        @db.Decimal(10, 2)
  allocation   MilkAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@unique([allocationId, destination])
}

model ProcessingBatch {
  id           String             @id @default(uuid())
  batchNumber  String             @unique
  date         DateTime           @db.Date
  rawMilkInput Decimal            @db.Decimal(10, 2)
  malaKg       Decimal            @default(0) @db.Decimal(10, 2)
  yoghurtKg    Decimal            @default(0) @db.Decimal(10, 2)
  fresh250     Int                @default(0)
  notes        String?
  createdAt    DateTime           @default(now())
  outputs      ProcessingOutput[]

  @@index([date])
}

model ProcessingOutput {
  id        String          @id @default(uuid())
  batchId   String
  productId String
  quantity  Decimal         @db.Decimal(10, 2)
  batch     ProcessingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
}

/// Products moved from MVA to Sales. Sales confirms receipt.
model ProductTransfer {
  id             String                @id @default(uuid())
  transferNumber String                @unique
  date           DateTime              @db.Date
  status         String                @default("sent")
  receivedAt     DateTime?
  receivedById   String?
  notes          String?
  allocationId   String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  items          ProductTransferItem[]
  allocation     MilkAllocation?       @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  request        ProductRequest?

  @@index([date, status])
}

model ProductTransferItem {
  id         String          @id @default(uuid())
  transferId String
  productId  String
  quantity   Decimal         @db.Decimal(10, 2)
  transfer   ProductTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// =====================================================================
// PRODUCTS AND STOCK LEDGER (shared by MVA and Sales)
// =====================================================================

model Product {
  id                String                @id @default(uuid())
  code              String                @unique
  name              String
  unit              String
  localPrice        Decimal               @default(0) @db.Decimal(10, 2)
  vehiclePrice      Decimal               @default(0) @db.Decimal(10, 2)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  movements         StockMovement[]
  processingOutputs ProcessingOutput[]
  transferItems     ProductTransferItem[]
  requestItems      ProductRequestItem[]
  saleItems         SaleItem[]
  dispatchItems     DispatchItem[]
  damages           DamageReplacement[]
}

/// Every stock change at MVA or Sales is one signed row. Stock on hand
/// for a product at a location is the sum of its quantities.
model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  location      String
  quantity      Decimal  @db.Decimal(12, 2)
  movementType  String
  referenceType String?
  referenceId   String?
  date          DateTime @db.Date
  notes         String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, location])
  @@index([date, location])
  @@index([referenceType, referenceId])
}

// =====================================================================
// SALES
// =====================================================================

model Sale {
  id            String        @id @default(uuid())
  saleNumber    String        @unique
  date          DateTime      @db.Date
  customerName  String?
  reference     String?
  paymentMethod String        @default("cash")
  totalAmount   Decimal       @db.Decimal(18, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(18, 2)
  status        String        @default("paid")
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         SaleItem[]
  payments      SalePayment[]

  @@index([date])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(18, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model SalePayment {
  id            String   @id @default(uuid())
  saleId        String
  date          DateTime @db.Date
  amount        Decimal  @db.Decimal(18, 2)
  paymentMethod String
  reference     String?
  createdAt     DateTime @default(now())
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
}

/// Vehicles that take milk to town. The crew is the driver and the
/// sales person who report back in the evening.
model Vehicle {
  id                 String            @id @default(uuid())
  registrationNumber String            @unique
  description        String?
  driverName         String
  driverPhone        String?
  salesPersonName    String
  salesPersonPhone   String?
  status             String            @default("active")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  dispatches         VehicleDispatch[]
}

/// Morning: products issued to a vehicle. Evening: the crew reports what
/// came back, what was damaged and the money handed in.
model VehicleDispatch {
  id              String              @id @default(uuid())
  dispatchNumber  String              @unique
  date            DateTime            @db.Date
  vehicleId       String
  driverName      String
  salesPersonName String
  status          String              @default("dispatched")
  expectedAmount  Decimal             @default(0) @db.Decimal(18, 2)
  cashReturned    Decimal             @default(0) @db.Decimal(18, 2)
  mpesaReturned   Decimal             @default(0) @db.Decimal(18, 2)
  bankDeposit     Decimal             @default(0) @db.Decimal(18, 2)
  variance        Decimal             @default(0) @db.Decimal(18, 2)
  reconciledAt    DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  items           DispatchItem[]
  records         DamageReplacement[]

  @@index([date, status])
}

model DispatchItem {
  id                 String          @id @default(uuid())
  dispatchId         String
  productId          String
  quantityDispatched Decimal         @db.Decimal(10, 2)
  quantityReturned   Decimal         @default(0) @db.Decimal(10, 2)
  quantityDamaged    Decimal         @default(0) @db.Decimal(10, 2)
  quantityReplaced   Decimal         @default(0) @db.Decimal(10, 2)
  quantitySold       Decimal         @default(0) @db.Decimal(10, 2)
  unitPrice          Decimal         @db.Decimal(10, 2)
  dispatch           VehicleDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
}

/// Stock written off as damaged, or given to a customer to replace a
/// spoilt product. Both reduce Sales stock.
model DamageReplacement {
  id           String           @id @default(uuid())
  recordNumber String           @unique
  date         DateTime         @db.Date
  recordType   String
  productId    String
  quantity     Decimal          @db.Decimal(10, 2)
  value        Decimal          @db.Decimal(18, 2)
  dispatchId   String?
  customerName String?
  reason       String?
  createdAt    DateTime         @default(now())
  product      Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  dispatch     VehicleDispatch? @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  /// Office use given out against a request from the administration.
  requestId    String?
  request      ProductRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([date, recordType])
}

/// A request for products from another department's stock. Sales asks MVA,
/// and MVA answers by sending the products to Sales (a product transfer,
/// which Sales receives as usual). The administration asks Sales, and Sales
/// gives the products out as office use: off Sales stock, not paid for.
model ProductRequest {
  id             String               @id @default(uuid())
  requestNumber  String               @unique
  date           DateTime             @db.Date
  /// The department asking; empty when the administration asks.
  fromDepartment Department?
  toDepartment   Department
  /// pending | sent | received (to MVA) | issued (to Sales) | declined | cancelled
  status         String               @default("pending")
  purpose        String?
  requestedById  String
  handledById    String?
  handledAt      DateTime?
  declineReason  String?
  transferId     String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          ProductRequestItem[]
  officeRecords  DamageReplacement[]
  requestedBy    User                 @relation("ProductRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  handledBy      User?                @relation("ProductRequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  transfer       ProductTransfer?     @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([toDepartment, status, date])
}

model ProductRequestItem {
  id            String         @id @default(uuid())
  requestId     String
  productId     String
  quantity      Decimal        @db.Decimal(10, 2)
  /// What was sent or given out against it.
  quantityGiven Decimal        @default(0) @db.Decimal(10, 2)
  request       ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// =====================================================================
// STORES
// =====================================================================

model StoreItem {
  id              String              @id @default(uuid())
  code            String              @unique
  name            String
  category        String
  unit            String
  quantityOnHand  Decimal             @default(0) @db.Decimal(12, 2)
  /// What the item held when it was added, and the day it was counted.
  /// With the receipts and issues since, this gives the stock on any day.
  openingQuantity Decimal             @default(0) @db.Decimal(12, 2)
  openingDate     DateTime?           @db.Date
  reorderLevel    Decimal             @default(0) @db.Decimal(12, 2)
  /// Not recorded by Stores; kept for purchase-order history in Accounts.
  unitCost        Decimal             @default(0) @db.Decimal(12, 2)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  receipts        StoreReceipt[]
  issues          StoreIssue[]
  orderItems      PurchaseOrderItem[]

  @@index([category])
}

model StoreReceipt {
  id              String         @id @default(uuid())
  receiptNumber   String         @unique
  date            DateTime       @db.Date
  itemId          String
  quantity        Decimal        @db.Decimal(12, 2)
  unitCost        Decimal        @default(0) @db.Decimal(12, 2)
  source          String         @default("purchase")
  supplierId      String?
  purchaseOrderId String?
  deliveryNote    String?
  notes           String?
  createdAt       DateTime       @default(now())
  item            StoreItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([date])
}

model StoreIssue {
  id            String       @id @default(uuid())
  issueNumber   String       @unique
  date          DateTime     @db.Date
  itemId        String
  quantity      Decimal      @db.Decimal(12, 2)
  department    Department
  issuedTo      String
  requisitionId String?
  purpose       String?
  createdAt     DateTime     @default(now())
  item          StoreItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requisition   Requisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)

  @@index([date, department])
}

// =====================================================================
// CROPS
// =====================================================================

model CropFarm {
  id             String          @id @default(uuid())
  farmNumber     String          @unique
  // Miller/factory registration number, e.g. 27431400 on the cane register.
  longFarmNumber String?
  // Cane variety, tea clone, or the fodder grown (Boma rhodes, sorghum...).
  variety        String?
  cropType       String
  acreage        Decimal         @db.Decimal(10, 2)
  // As recorded on the register; worked out from acreage when blank.
  hectares       Decimal?        @db.Decimal(10, 2)
  // Sugarcane: expected tonnes of cane per hectare (TCH).
  expectedTch    Decimal?        @db.Decimal(8, 2)
  // Tea and coffee: target kilograms per plucking day.
  dailyTarget    Decimal?        @db.Decimal(12, 2)
  location       String
  plantingDate   DateTime?
  ratoonCount    Int             @default(0)
  // When the standing crop started: planting, or the last cut for ratoons.
  cycleStartDate DateTime?       @db.Date
  status         String          @default("land_preparation")
  statusNote     String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  harvests       CropHarvest[]
  statusLogs     CropStatusLog[]

  @@index([cropType, status])
}

model CropStatusLog {
  id        String   @id @default(uuid())
  farmId    String
  date      DateTime @db.Date
  status    String
  note      String?
  createdAt DateTime @default(now())
  farm      CropFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([date])
}

model CropHarvest {
  id          String   @id @default(uuid())
  farmId      String
  harvestDate DateTime @db.Date
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String
  // Tea and coffee: the target for that day, copied from the farm.
  target      Decimal? @db.Decimal(12, 2)
  buyer       String?
  amount      Decimal  @default(0) @db.Decimal(18, 2)
  notes       String?
  createdAt   DateTime @default(now())
  farm        CropFarm @relation(fields: [farmId], references: [id], onDelete: Restrict)

  @@index([harvestDate])
}

// =====================================================================
// ACCOUNTS: MONEY ACCOUNTS, INCOME/EXPENSES, PAYMENTS, PROCUREMENT
// =====================================================================

model Account {
  id             String        @id @default(uuid())
  name           String        @unique
  accountType    String
  accountNumber  String?
  openingBalance Decimal       @default(0) @db.Decimal(18, 2)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
}

/// One income or expense entry. category is one of the fixed income or
/// expense heads configured in src/config/accounts.js.
model Transaction {
  id          String      @id @default(uuid())
  reference   String      @unique
  date        DateTime    @db.Date
  type        String
  category    String
  accountId   String
  amount      Decimal     @db.Decimal(18, 2)
  description String
  party       String?
  department  Department?
  sourceType  String?
  sourceId    String?
  status      String      @default("posted")
  voidReason  String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date, type, category])
  @@index([sourceType, sourceId])
}

/// Payment to farmers for milk delivered over a period.
model MilkPaymentRun {
  id            String            @id @default(uuid())
  runNumber     String            @unique
  periodStart   DateTime          @db.Date
  periodEnd     DateTime          @db.Date
  totalLitres   Decimal           @db.Decimal(12, 2)
  totalAmount   Decimal           @db.Decimal(18, 2)
  status        String            @default("draft")
  paidAt        DateTime?
  transactionId String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lines         MilkPaymentLine[]
  deliveries    MilkDelivery[]
}

model MilkPaymentLine {
  id         String         @id @default(uuid())
  runId      String
  supplierId String
  litres     Decimal        @db.Decimal(12, 2)
  amount     Decimal        @db.Decimal(18, 2)
  deductions Decimal        @default(0) @db.Decimal(18, 2)
  netAmount  Decimal        @db.Decimal(18, 2)
  run        MilkPaymentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  supplier   MilkSupplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
}

/// Dividends and other payments to pioneer members or their successors.
model MemberPayment {
  id            String   @id @default(uuid())
  memberId      String
  date          DateTime @db.Date
  paymentType   String   @default("dividend")
  amount        Decimal  @db.Decimal(18, 2)
  description   String?
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
}

/// A department asks for something; Accounts or the General Manager decides.
model Requisition {
  id                String            @id @default(uuid())
  requisitionNumber String            @unique
  department        Department
  title             String
  purpose           String
  priority          String            @default("normal")
  totalAmount       Decimal           @db.Decimal(18, 2)
  status            String            @default("pending")
  requestedById     String
  decidedById       String?
  decidedAt         DateTime?
  decisionComment   String?
  fulfilledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  requestedBy       User              @relation("RequisitionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy         User?             @relation("RequisitionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  items             RequisitionItem[]
  storeIssues       StoreIssue[]
  purchaseOrders    PurchaseOrder[]

  @@index([department, status, createdAt])
}

model RequisitionItem {
  id            String      @id @default(uuid())
  requisitionId String
  description   String
  quantity      Decimal     @db.Decimal(12, 2)
  unit          String?
  unitCost      Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(18, 2)
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
}

model Supplier {
  id             String          @id @default(uuid())
  name           String          @unique
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  kraPin         String?
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  receipts       StoreReceipt[]
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique
  date          DateTime            @db.Date
  supplierId    String
  requisitionId String?
  totalAmount   Decimal             @db.Decimal(18, 2)
  amountPaid    Decimal             @default(0) @db.Decimal(18, 2)
  status        String              @default("ordered")
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requisition   Requisition?        @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]
  receipts      StoreReceipt[]

  @@index([date, status])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  storeItemId      String?
  description      String
  quantity         Decimal       @db.Decimal(12, 2)
  quantityReceived Decimal       @default(0) @db.Decimal(12, 2)
  unitPrice        Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(18, 2)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  storeItem        StoreItem?    @relation(fields: [storeItemId], references: [id], onDelete: SetNull)
}
