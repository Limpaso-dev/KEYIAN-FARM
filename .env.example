# Local PostgreSQL. Use a URL-encoded password if it contains reserved URL characters.
POSTGRES_PASSWORD=replace_with_a_local_database_password
DATABASE_URL=postgresql://keiyian_user:replace_with_a_local_database_password@127.0.0.1:5432/keiyian_erp?schema=public
DATABASE_URL_DOCKER=postgresql://keiyian_user:replace_with_a_local_database_password@postgres:5432/keiyian_erp?schema=public

# Express and authentication
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
DOMAIN_NAME=localhost
CLIENT_URL_DOCKER=http://localhost
SEED_ADMIN_NAME=Keiyian System Administrator

# Optional initial administrator seed credentials; never use production credentials here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
